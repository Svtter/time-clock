<Window x:Class="TimeClock.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="日志 - TimeClock"
        Width="650" Height="450"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFFAFAFA">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0" x:Name="LogContent"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 Background="White"
                 BorderBrush="#DDDDDD"
                 Padding="8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="刷新" Width="80" Height="28" Margin="0,0,8,0"
                    Click="BtnRefresh_Click" FontFamily="Microsoft YaHei UI"/>
            <Button Content="关闭" Width="80" Height="28"
                    Click="BtnClose_Click" FontFamily="Microsoft YaHei UI"/>
        </StackPanel>
    </Grid>
</Window>
