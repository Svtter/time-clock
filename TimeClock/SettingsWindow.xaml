<Window x:Class="TimeClock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 - TimeClock"
        Width="460" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF5F5F5">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White">

            <TabItem Header="常规">
                <StackPanel Margin="12">
                    <CheckBox x:Name="ChkAutoStart" Content="开机自动启动"
                              FontSize="14" FontFamily="Microsoft YaHei UI" Margin="0,5"/>

                    <CheckBox x:Name="ChkSecondHand" Content="显示秒针"
                              FontSize="14" FontFamily="Microsoft YaHei UI" Margin="0,10,0,5"/>

                    <Button Content="打开日志文件夹..."
                            Click="BtnOpenLog_Click"
                            FontSize="12" FontFamily="Microsoft YaHei UI"
                            Padding="12,4" HorizontalAlignment="Left" Margin="0,15,0,0"
                            Background="White" BorderBrush="#CCCCCC"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="闹钟">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top"
                               Text="时间格式 HH:mm（例如 07:30），标签可选。到点时时钟会晃动提醒，点击时钟可停止。"
                               FontSize="11" Foreground="#888888"
                               FontFamily="Microsoft YaHei UI"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button DockPanel.Dock="Bottom" Content="添加闹钟"
                            Click="BtnAddAlarm_Click"
                            FontSize="12" FontFamily="Microsoft YaHei UI"
                            Padding="12,4" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                    <ListBox x:Name="LstAlarms"
                             BorderBrush="#CCCCCC"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip="启用/禁用"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="62" FontSize="14"
                                             FontFamily="Consolas"
                                             VerticalAlignment="Center"
                                             ToolTip="时间 HH:mm"/>

                                    <TextBox Grid.Column="2"
                                             Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" FontFamily="Microsoft YaHei UI"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             ToolTip="标签（可选）"/>

                                    <Button Grid.Column="3" Content="删除"
                                            Click="BtnRemoveAlarm_Click"
                                            FontSize="11" FontFamily="Microsoft YaHei UI"
                                            Padding="8,2" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="White" BorderBrush="#CCCCCC"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,10,0"
                    Click="BtnOK_Click" FontFamily="Microsoft YaHei UI"
                    Background="#FF4CAF50" Foreground="White" BorderThickness="0"/>
            <Button Content="取消" Width="80" Height="30"
                    Click="BtnCancel_Click" FontFamily="Microsoft YaHei UI"/>
        </StackPanel>
    </Grid>
</Window>
